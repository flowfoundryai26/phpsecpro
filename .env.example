# Lead form -> Google Sheets integration.
#
# This is the deployed Google Apps Script Web App URL that receives new
# website inquiries and appends them to the "Leads" Google Sheet. It is read
# only on the server (src/app/api/leads/route.ts) and must NEVER be prefixed
# with NEXT_PUBLIC_ — doing so would expose it to the browser.
#
# Without this set, the lead form will show a clear "not configured" message
# instead of faking a successful submission.
GOOGLE_APPS_SCRIPT_URL=
